@{"urn:uuid:f05413d7-652a-445d-9e44-18273ca7a223"^^\iri} imp#evaluateSentence(lessThan(?SMALL, ?BIG)) :- imp#evaluateSentence(greaterThan(?BIG, ?SMALL)) .
