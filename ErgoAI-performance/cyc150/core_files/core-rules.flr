@{"urn:uuid:36828249-990a-427e-8e99-0204d87d5f38"^^\iri} tvaSentence(?P(?ARG1, ?NEW2, ?ARG3)) :- imp#tvaPredicate(?P) , assertedSentence(transitiveViaArg(?P, ?LINK, (2))) , removalSentence(?P(?ARG1, ?ARG2, ?ARG3)) , ?ARG2 != ?NEW2 , removalSentence(?LINK(?ARG2, ?NEW2)) .
@{"urn:uuid:1fd16543-a0f1-453f-87fe-246259ca98a0"^^\iri} tvaSentence(?P(?ARG1, ?ARG2, ?NEW3)) :- imp#tvaPredicate(?P) , assertedSentence(transitiveViaArg(?P, ?LINK, (3))) , removalSentence(?P(?ARG1, ?ARG2, ?ARG3)) , ?ARG3 != ?NEW3 , removalSentence(?LINK(?ARG3, ?NEW3)) .
@{"urn:uuid:b37a932c-3391-4788-b612-ae48c514b1cd"^^\iri} tvaSentence(?P(?NEW1)) :- \naf hlPred(?P) , assertedSentence(transitiveViaArgInverse(?P, ?LINK, (1))) , removalSentence(?LINK(?NEW1, ?ARG1)) , ?ARG1 != ?NEW1 , removalSentence(?P(?ARG1)) .
@{"urn:uuid:84633076-c02b-4ff8-8f30-fa63f8271e51"^^\iri} tvaSentence(?P(?NEW1, ?ARG2)) :- imp#tvaPredicate(?P) , assertedSentence(transitiveViaArgInverse(?P, ?LINK, (1))) , removalSentence(?P(?ARG1, ?ARG2)) , ?ARG1 != ?NEW1 , removalSentence(?LINK(?NEW1, ?ARG1)) .
@{"urn:uuid:49b670a1-64ca-419f-a3dc-dc03cb3351c8"^^\iri} tvaSentence(?P(?ARG1, ?NEW2)) :- imp#tvaPredicate(?P) , assertedSentence(transitiveViaArgInverse(?P, ?LINK, (2))) , removalSentence(?P(?ARG1, ?ARG2)) , ?ARG2 != ?NEW2 , removalSentence(?LINK(?NEW2, ?ARG2)) .
@{"urn:uuid:a060e8d7-5063-4a6d-9fba-aca09a6bdd47"^^\iri} tvaSentence(?P(?NEW1, ?ARG2, ?ARG3)) :- imp#tvaPredicate(?P) , assertedSentence(transitiveViaArgInverse(?P, ?LINK, (1))) , removalSentence(?P(?ARG1, ?ARG2, ?ARG3)) , ?ARG1 != ?NEW1 , removalSentence(?LINK(?NEW1, ?ARG1)) .
