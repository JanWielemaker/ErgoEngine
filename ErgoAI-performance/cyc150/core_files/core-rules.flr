@{"urn:uuid:c9a98e8d-bf0c-434c-9980-c1994647b359"^^\iri} transformationSentence(?ASENT) :- backwardSentence(?ASENT) .
@{"urn:uuid:048ea023-dda9-480a-8b3e-14ffb31ab6aa"^^\iri} transformationSentence(not(?ASENT)) :- backwardSentence(not(?ASENT)) .
@{"urn:uuid:f2a1f27e-7e25-4b75-8127-aa49283569f1"^^\iri} transformationSentence(?ASENT) :- imp#isAtomicSentence(?ASENT) , imp#destructureFormula(?ASENT, ?P, ?ARGS) , sbhlSentence(genlPreds(?SPEC, ?P)) , ?SPEC != ?P , imp#destructureFormula(?ASENT2, ?SPEC, ?ARGS) , backwardSentence(?ASENT2) .
@{"urn:uuid:7b6fa265-f37d-41db-9399-6041f0111ade"^^\iri} transformationSentence(not(?ASENT)) :- imp#isAtomicSentence(?ASENT) , imp#destructureFormula(?ASENT, ?P, ?ARGS) , sbhlSentence(negationPreds(?P, ?NP)) , imp#destructureFormula(?ASENT2, ?NP, ?ARGS) , backwardSentence(?ASENT2) .
@{"urn:uuid:ff1f2442-ba9c-4deb-84b8-35973eb21ac6"^^\iri} transformationSentence(?SP(?ARG1, ?ARG2)) :- sbhlSentence(cycIsa(?SP, SymmetricBinaryPredicate)) , backwardSentence(?SP(?ARG2, ?ARG1)) .
