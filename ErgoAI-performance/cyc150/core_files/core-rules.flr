@{"urn:uuid:94afb6a7-7690-4c88-bbb9-6566ccbb6725"^^\iri} tvaSentence(?P(?NEW1)) :- imp#tvaPredicate(?P) , assertedSentence(transitiveViaArg(?P, ?LINK, (1))) , removalSentence(?LINK(?ARG1, ?NEW1)) , ?ARG1 != ?NEW1 , removalSentence(?P(?ARG1)) .
@{"urn:uuid:0394b21a-e317-4fa3-86e4-4c8d2e208ec9"^^\iri} tvaSentence(?P(?NEW1, ?ARG2)) :- imp#tvaPredicate(?P) , assertedSentence(transitiveViaArg(?P, ?LINK, (1))) , removalSentence(?P(?ARG1, ?ARG2)) , ?ARG1 != ?NEW1 , removalSentence(?LINK(?ARG1, ?NEW1)) .
