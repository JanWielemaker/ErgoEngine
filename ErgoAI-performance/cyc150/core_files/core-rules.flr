:- iriprefix{silk = "http://vulcan.com/2008/silk#"}.
:- iriprefix{dc = "http://purl.org/dc/elements/1.1/"}.
:- iriprefix{imp = "http://www.cyc.com/silk/implementation/"}.
:- iriprefix{swrlb = "http://www.w3.org/2003/11/swrlb"}.
:- iriprefix{cyc = "http://sw.cyc.com/2009/04/07/concept/"}.
:- iriprefix{silkb = "http://vulcan.com/2008/silk-builtins#"}.
:- use_argumentation_theory{ogcle} .
?- [ogclpe>>ogcle] .
\overrides(?X,?Y) :- silk#overrides(?X,?Y) .
\overrides(?X,?Y,?Z,?W) :- silk#overrides(?X,?Y,?Z,?W) .
:- iriprefix{swrlb = "http://www.w3.org/2003/11/swrlb"}.
impPred(istAsserted) .
impPred(queryMt) .
impPred(imp#directVisible) .
@{"urn:uuid:9dbc8615-fa10-4cbc-870a-2fc8f579fbd7"^^\iri} imp#directVisible(?MT) :- queryMt(?MT) .
impPred(mtVisible) .
@{"urn:uuid:2a352aa2-b742-430a-9bd4-7f371b9a9469"^^\iri} mtVisible(?MT) :- imp#directVisible(?MT) .
@{"urn:uuid:01d05706-6606-4090-9736-b3500437d6f8"^^\iri} mtVisible(?GENL) :- imp#directVisible(?SPEC) , sbhlSentence(genlMt(?SPEC, ?GENL)) .
@{"urn:uuid:8ab04069-28ac-45c5-8938-895a5e977ee3"^^\iri} mtVisible(?MT) :- queryMt(EverythingPSC) , sbhlSentence(cycIsa(?MT, Microtheory)) .
impPred(assertedSentence) .
@{"urn:uuid:e410833d-65d2-44a2-862f-fc60b179234a"^^\iri} assertedSentence(?P) :- istAsserted(?MT, ?P) , mtVisible(?MT) .
impPred(lookupSentence) .
@{"urn:uuid:a6313420-f4a2-4b0e-a37b-46a38d9443ba"^^\iri} lookupSentence(?ASENT) :- assertedSentence(?ASENT) .
@{"urn:uuid:f6184de0-a85c-4335-ad28-5c205e1812d2"^^\iri} lookupSentence(?ASENT) :- forwardSentence(?ASENT) .
impPred(forwardSentence) .
@{"urn:uuid:303ed75e-32ae-42d6-829b-8690460a6ee9"^^\iri} forwardSentence(arity(?R, (2))) :- mtVisible(BaseKB) , removalSentence(cycIsa(?R, BinaryRelation)) .
@{"urn:uuid:1fb153ba-85a4-485d-91e3-ecee95703912"^^\iri} forwardSentence(cycIsa(?NART, ?COL)) :- mtVisible(BaseKB) , removalSentence(natFunction(?NART, ?F)) , removalSentence(resultIsa(?F, ?COL)) .
impPred(imp#destructureFormula) .
@{"urn:uuid:a2ba95b7-1e17-4dde-91c1-0bd6d0bd880a"^^\iri} imp#destructureFormula(?TERM, ?R, ?ARGS) :- ?TERM =.. [hilog(?R) | ?ARGS] .
impPred(imp#isNonAtomic) .
@{"urn:uuid:880cf2d8-ac83-4b13-a4b4-feef2e578817"^^\iri} imp#isNonAtomic(?X) :- imp#destructureFormula(?X, ?_R, ?_ARGS) .
@{"urn:uuid:2da2516d-30bd-45b7-922f-1b9c3d2ef7dd"^^\iri} imp#isNonAtomic(?X) :- %silkb#isGround(?X)@builtin , \naf imp#isAtomic(?X) .
impPred(formulaArity) .
@{"urn:uuid:a4bd76f3-1169-44b9-aee8-6d5c421b89c8"^^\iri} formulaArity(?FORM, ?ARITY) :- imp#destructureFormula(?FORM, ?RELN, ?ARGS) , imp#listLength(?ARITY, ?ARGS) .
impPred(operatorFormulas) .
@{"urn:uuid:70dbc51e-da07-4458-a0db-066562d61e2a"^^\iri} operatorFormulas(?R, ?TERM) :- \+ %silkb#isGround(?TERM)@builtin , imp#destructureFormula(?TERM, ?R, ?_ARGS) , %silkb#isGround(?R)@builtin .
@{"urn:uuid:caf04260-9962-4d5e-bfcd-0b4ffb340901"^^\iri} operatorFormulas(?R, ?TERM) :- %silkb#isGround(?TERM)@builtin , imp#isNonAtomic(?TERM) , imp#arg0((1), ?TERM, ?R) .
impPred(argN) .
@{"urn:uuid:8e0efa42-b4f0-45ba-8830-a0533f9100b0"^^\iri} argN(?ARG, ?ARGNUM, ?NAT) :- %silkb#isGround(?ARGNUM)@builtin , %silkb#isInteger(?ARGNUM)@builtin , ?ARGNUM  >=  (0) , %silkb#isGround(?NAT)@builtin , imp#isNonAtomic(?NAT) , ?_INDEX \is (?ARGNUM  +  (1)) , imp#arg0(?_INDEX, ?NAT, ?ARG) .
@{"urn:uuid:529fc17e-6feb-4f1d-9fda-8fe9766fffe8"^^\iri} argN(?ARG, ?ARGNUM, ?NAT) :- %silkb#isGround(?NAT)@builtin , imp#isNonAtomic(?NAT) , \+ %silkb#isGround(?ARGNUM)@builtin , %silkb#listMember([(1), (2), (3), (4), (5), (6)], ?_INDEX)@builtin , imp#arg0(?_INDEX, ?NAT, ?ARG) , ?ARGNUM \is (?_INDEX  -  (1)) .
impPred(imp#listMember) .
@{"urn:uuid:d152d97d-c321-45f5-969c-f87e4c79f150"^^\iri} imp#listMember(?X, [?X | ?_Y]) :- %silkb#isGround(?X)@builtin .
@{"urn:uuid:959b8ecd-c1f5-4ab2-95d3-9821f90d06ac"^^\iri} imp#listMember(?X, [?_Y | ?Z]) :- imp#listMember(?X, ?Z) .
impPred(imp#setElement) .
@{"urn:uuid:7fd5e0f1-49b2-4891-ad1a-eb74cffe5499"^^\iri} imp#setElement(?X, SetOfListMembersFn(?LIST)) :- %silkb#isList(?LIST)@builtin , imp#listMember(?X, ?LIST) .
impPred(imp#listLength) .
imp#listLength((0), []) .
@{"urn:uuid:af65fb13-b0f3-4db7-b99b-da03d5bff2b7"^^\iri} imp#listLength(?LEN, [?_FIRST | ?REST]) :- imp#listLength(?RL, ?REST) , ?LEN \is (?RL  +  (1)) .
impPred(imp#setCardinality) .
@{"urn:uuid:c9f28aef-63c0-4c00-a6bc-2806a09f2ac2"^^\iri} imp#setCardinality(?CARD, SetOfListMembersFn(?LIST)) :- %silkb#isGround(?LIST)@builtin , %silkb#isList(?LIST)@builtin , imp#listLength(?CARD, ?LIST) .
impPred(imp#operatorInList) .
@{"urn:uuid:87f4756a-f41e-473f-97f5-3a8893bf73a4"^^\iri} imp#operatorInList(?FORMULA, ?LIST) :- operatorFormulas(?RELN, ?FORMULA) , imp#listMember(?RELN, ?LIST) .
impPred(imp#digitString) .
imp#digitString((0), ("0"^^\string)) .
imp#digitString((1), ("1"^^\string)) .
imp#digitString((2), ("2"^^\string)) .
imp#digitString((3), ("3"^^\string)) .
imp#digitString((4), ("4"^^\string)) .
imp#digitString((5), ("5"^^\string)) .
imp#digitString((6), ("6"^^\string)) .
imp#digitString((7), ("7"^^\string)) .
imp#digitString((8), ("8"^^\string)) .
imp#digitString((9), ("9"^^\string)) .
@{"urn:uuid:33138c52-6756-4e0f-9172-345f3d86d55a"^^\iri} \neg imp#digitString(?N, ?S) :- \naf imp#digitString(?N, ?S) .
impPred(imp#toInteger) .
@{"urn:uuid:8009f396-d8fe-4ba3-a437-2c4d2b7bb213"^^\iri} imp#toInteger(?N, ?STRING) :- imp#digitString(?N, ?STRING) .
@{"urn:uuid:ce06df04-9d71-4206-86f6-89d29e121f2a"^^\iri} imp#toInteger(?N, ?STRING) :- %swrlb#stringLength((2), ?STRING)@builtin , imp#digitString(?TENS, ?TD) , %swrlb#substring(?TD, ?STRING, (1), (1))@builtin , imp#digitString(?ONES, ?OD) , %swrlb#substring(?OD, ?STRING, (2), (1))@builtin , ?N \is (((10)  *  ?TENS)  +  ?ONES) .
@{"urn:uuid:29a55d3f-c712-4b4c-a1cc-e43e249b5b6b"^^\iri} imp#toInteger(?N, ?STRING) :- %swrlb#stringLength((3), ?STRING)@builtin , imp#digitString(?HUNS, ?HD) , %swrlb#substring(?HD, ?STRING, (1), (1))@builtin , imp#digitString(?TENS, ?TD) , %swrlb#substring(?TD, ?STRING, (2), (1))@builtin , imp#digitString(?ONES, ?OD) , %swrlb#substring(?OD, ?STRING, (3), (1))@builtin , ?N \is ((((100)  *  ?HUNS)  +  (((10)  *  ?TENS)  +  ?ONES))) .
@{"urn:uuid:930b88be-6cf7-4c9a-8446-729e22cb4719"^^\iri} imp#toInteger(?N, ?STRING) :- %swrlb#stringLength((2), ?STRING)@builtin , %swrlb#substring(("-"^^\string), ?STRING, (1), (1))@builtin , imp#digitString(?ONES, ?OD) , %swrlb#substring(?OD, ?STRING, (2), (1))@builtin , ?N \is ((-1)  *  ?ONES) .
@{"urn:uuid:9565d4e4-455e-4b9e-ba20-df9dc0f05bf3"^^\iri} imp#toInteger(?N, ?STRING) :- %swrlb#stringLength((3), ?STRING)@builtin , %swrlb#substring(("-"^^\string), ?STRING, (1), (1))@builtin , imp#digitString(?TENS, ?TD) , %swrlb#substring(?TD, ?STRING, (2), (1))@builtin , imp#digitString(?ONES, ?OD) , %swrlb#substring(?OD, ?STRING, (3), (1))@builtin , ?N \is ((-1)  *  (((10)  *  ?TENS)  +  ?ONES)) .
@{"urn:uuid:5c7706b2-7084-4a78-96ca-9cfd8e0d6f05"^^\iri} imp#toInteger(?N, ?STRING) :- %swrlb#stringLength((4), ?STRING)@builtin , %swrlb#substring(("-"^^\string), ?STRING, (1), (1))@builtin , imp#digitString(?HUNS, ?HD) , %swrlb#substring(?HD, ?STRING, (2), (1))@builtin , imp#digitString(?TENS, ?TD) , %swrlb#substring(?TD, ?STRING, (3), (1))@builtin , imp#digitString(?ONES, ?OD) , %swrlb#substring(?OD, ?STRING, (4), (1))@builtin , ?N \is ((-1)  *  (((100)  *  ?HUNS)  +  (((10)  *  ?TENS)  +  ?ONES))) .
@{"urn:uuid:4de1db15-1464-499c-8b06-ae7be9966fd8"^^\iri} \neg imp#toInteger(?N, ?STRING) :- \naf imp#toInteger(?N, ?STRING) .
impPred(integerBetween) .
@{"urn:uuid:c1a5413e-2d8c-422e-a110-9c15dd993a18"^^\iri} integerBetween(?LOW, ?LOW, ?HI) :- %silkb#isInteger(?HI)@builtin , %silkb#isInteger(?LOW)@builtin , ?HI  >=  ?LOW .
@{"urn:uuid:4af9d6b6-21cc-4639-af65-e61f837135ce"^^\iri} integerBetween(?LOW, ?MID, ?HI) :- %silkb#isInteger(?HI)@builtin , %silkb#isInteger(?LOW)@builtin , ?HI  >=  ?LOW , integerBetween(?LOW, ?LOWMID, ?HI) , ?MID \is ?LOWMID  +  (1) , ?HI  >=  ?MID .
impPred(imp#directIsa) .
@{"urn:uuid:39bf9638-73b8-4973-91ee-38e47c3dc779"^^\iri} imp#directIsa(?OBJ, ?COL) :- lookupSentence(cycIsa(?OBJ, ?COL)) .
@{"urn:uuid:a55788ea-fa86-4cb1-b7d9-626d0db6dd9a"^^\iri} imp#directIsa(?NAT, ?COL) :- operatorFormulas(?FUNC, ?NAT) , lookupSentence(resultIsa(?FUNC, ?COL)) .
impPred(imp#directQuotedIsa) .
@{"urn:uuid:99ef962e-5f37-44f3-acd5-bd90b5951d4a"^^\iri} imp#directQuotedIsa(?OBJ, ?COL) :- lookupSentence(quotedIsa(?OBJ, ?COL)) .
impPred(imp#directGenls) .
@{"urn:uuid:7b857d01-f2af-4ef3-815f-473cda4cb14a"^^\iri} imp#directGenls(?SPEC, ?GENL) :- lookupSentence(genls(?SPEC, ?GENL)) .
@{"urn:uuid:b4d7dd17-082c-4f7a-8d75-2c13a51e74f1"^^\iri} imp#directGenls(?NAT, ?COL) :- operatorFormulas(?FUNC, ?NAT) , lookupSentence(resultGenl(?FUNC, ?COL)) .
impPred(imp#disjointWithLink) .
@{"urn:uuid:c0d707d4-32a0-4b65-b5dc-7fc90106f14f"^^\iri} imp#disjointWithLink(?A, ?B) :- lookupSentence(disjointWith(?A, ?B)) .
@{"urn:uuid:14c31844-469a-41fd-87b8-e0f3258fef9c"^^\iri} imp#disjointWithLink(?A, ?B) :- lookupSentence(disjointWith(?B, ?A)) .
@{"urn:uuid:c67ecffd-4a25-4f4d-850d-97ebd6c4e300"^^\iri} sbhlSentence(cycIsa(?OBJ, ?COL)) :- imp#directIsa(?OBJ, ?COL) .
@{"urn:uuid:5a51622c-d0a3-4060-8fbb-0a33d49ec4f7"^^\iri} sbhlSentence(cycIsa(?X, Thing)) :- %silkb#isGround(?X)@builtin .
@{"urn:uuid:27f5c1fe-d5fc-401e-87df-e888792fa1bb"^^\iri} sbhlSentence(cycIsa(?OBJ, ?GENL)) :- %silkb#isGround(?OBJ)@builtin , imp#directIsa(?OBJ, ?SPEC) , sbhlSentence(genls(?SPEC, ?GENL)) .
@{"urn:uuid:7a5a84e8-da90-4194-bf19-75e4d4716a6f"^^\iri} sbhlSentence(cycIsa(?OBJ, ?GENL)) :- %silkb#isGround(?GENL)@builtin , \+ %silkb#isGround(?OBJ)@builtin , sbhlSentence(genls(?SPEC, ?GENL)) , imp#directIsa(?OBJ, ?SPEC) .
@{"urn:uuid:5e1190b7-ea04-411d-9cac-7bd5cb61746a"^^\iri} sbhlSentence(not(cycIsa(?TERM, ?COL))) :- %silkb#isGround(?TERM)@builtin , %silkb#isGround(?COL)@builtin , \naf sbhlSentence(cycIsa(?TERM, ?COL)) , imp#directIsa(?TERM, ?NEAR) , sbhlSentence(disjointWith(?NEAR, ?COL)) .
// Added (ergo301-performance): a negative genls from disjointness, the
// genls twin of the rule above and Cyc's SBHL behaviour.  ?GENL itself may
// be the disjoint collection, so no reflexive genls (Collection) is needed.
@{"urn:uuid:ergo301-performance-not-genls"^^\iri} sbhlSentence(not(genls(?SPEC, ?GENL))) :- %silkb#isGround(?SPEC)@builtin , %silkb#isGround(?GENL)@builtin , \naf sbhlSentence(genls(?SPEC, ?GENL)) , sbhlSentence(genls(?SPEC, ?A)) , imp#disjointWithLink(?A, ?B) , (?B = ?GENL ; sbhlSentence(genls(?GENL, ?B))) .
@{"urn:uuid:5e494de1-7a7e-4244-8791-52abe73bc8e8"^^\iri} sbhlSentence(genls(?SPEC, ?GENL)) :- imp#directGenls(?SPEC, ?GENL) .
@{"urn:uuid:c1233ba4-60e7-423c-b2b8-d5feaece6ccc"^^\iri} sbhlSentence(genls(?COL, ?COL)) :- sbhlSentence(cycIsa(?COL, Collection)) .
@{"urn:uuid:d0fcf228-3425-4504-9ca5-5494157b5801"^^\iri} sbhlSentence(genls(?LOW, ?HIGH)) :- %silkb#isGround(?LOW)@builtin , imp#directGenls(?LOW, ?MID) , sbhlSentence(genls(?MID, ?HIGH)) .
@{"urn:uuid:3544ee4f-d8d5-4c82-bd07-145c2a1340c8"^^\iri} sbhlSentence(genls(?LOW, ?HIGH)) :- %silkb#isGround(?HIGH)@builtin , \+ %silkb#isGround(?LOW)@builtin , imp#directGenls(?MID, ?HIGH) , sbhlSentence(genls(?LOW, ?MID)) .
@{"urn:uuid:7c9c7e39-07aa-4775-8d62-25367ed2a4f5"^^\iri} sbhlSentence(disjointWith(?A, ?B)) :- \+ %silkb#isGround(?A)@builtin , %silkb#isGround(?B)@builtin , sbhlSentence(disjointWith(?B, ?A)) .
@{"urn:uuid:d60d5dee-a057-40c2-ac9e-cacfa0ede9ae"^^\iri} sbhlSentence(disjointWith(?LOWA, ?LOWB)) :- %silkb#isGround(?LOWA)@builtin , sbhlSentence(genls(?LOWA, ?A)) , imp#disjointWithLink(?A, ?B) , sbhlSentence(genls(?LOWB, ?B)) .
@{"urn:uuid:318e08e6-f4d2-4559-9958-cee75a7f610e"^^\iri} sbhlSentence(genlPreds(?SPEC, ?GENL)) :- lookupSentence(genlPreds(?SPEC, ?GENL)) .
@{"urn:uuid:b87f6d16-65f3-4307-bb23-3a6a96dc03f6"^^\iri} sbhlSentence(genlPreds(?P, ?P)) :- sbhlSentence(cycIsa(?P, Predicate)) .
@{"urn:uuid:8ee5e7d3-dc76-4480-b18b-06d3bbba536a"^^\iri} sbhlSentence(genlPreds(?LOW, ?HIGH)) :- %silkb#isGround(?LOW)@builtin , lookupSentence(genlPreds(?LOW, ?MID)) , sbhlSentence(genlPreds(?MID, ?HIGH)) .
@{"urn:uuid:da5afe52-54ef-4a62-b0e2-e76cf2831d7a"^^\iri} sbhlSentence(genlPreds(?LOW, ?HIGH)) :- %silkb#isGround(?HIGH)@builtin , \+ %silkb#isGround(?LOW)@builtin , lookupSentence(genlPreds(?MID, ?HIGH)) , sbhlSentence(genlPreds(?LOW, ?MID)) .
@{"urn:uuid:3b48cb23-6fff-4cca-a551-aa3f5cb321c1"^^\iri} sbhlSentence(genlPreds(?LOW, ?HIGH)) :- %silkb#isGround(?LOW)@builtin , lookupSentence(genlInverse(?LOW, ?MID)) , sbhlSentence(genlInverse(?MID, ?HIGH)) .
@{"urn:uuid:b6a117f6-e62a-4e1e-b056-ca0e543053f2"^^\iri} sbhlSentence(genlPreds(?LOW, ?HIGH)) :- %silkb#isGround(?HIGH)@builtin , \+ %silkb#isGround(?LOW)@builtin , lookupSentence(genlInverse(?MID, ?HIGH)) , sbhlSentence(genlInverse(?LOW, ?MID)) .
@{"urn:uuid:bcea6e1d-b5c7-4ab6-9818-33e5a43c1f21"^^\iri} sbhlSentence(genlInverse(?SPEC, ?GENL)) :- lookupSentence(genlInverse(?SPEC, ?GENL)) .
@{"urn:uuid:799c3444-8898-46b3-9a94-87df645feea0"^^\iri} sbhlSentence(genlInverse(?P, ?P)) :- sbhlSentence(cycIsa(?P, SymmetricBinaryPredicate)) .
@{"urn:uuid:6614797b-c388-43e5-b65a-551b5e1f9400"^^\iri} sbhlSentence(genlInverse(?LOW, ?HIGH)) :- %silkb#isGround(?LOW)@builtin , lookupSentence(genlPreds(?LOW, ?MID)) , sbhlSentence(genlInverse(?MID, ?HIGH)) .
@{"urn:uuid:65ed24d6-6a9a-4ecd-bfb9-504e7c0504b0"^^\iri} sbhlSentence(genlInverse(?LOW, ?HIGH)) :- %silkb#isGround(?HIGH)@builtin , \+ %silkb#isGround(?LOW)@builtin , lookupSentence(genlPreds(?MID, ?HIGH)) , sbhlSentence(genlInverse(?LOW, ?MID)) .
@{"urn:uuid:bf673502-8f94-4907-a879-cfcfd5056478"^^\iri} sbhlSentence(genlInverse(?LOW, ?HIGH)) :- %silkb#isGround(?LOW)@builtin , lookupSentence(genlInverse(?LOW, ?MID)) , sbhlSentence(genlPreds(?MID, ?HIGH)) .
@{"urn:uuid:e529f3f2-e731-482f-a25f-b011b4588bf7"^^\iri} sbhlSentence(genlInverse(?LOW, ?HIGH)) :- %silkb#isGround(?HIGH)@builtin , \+ %silkb#isGround(?LOW)@builtin , lookupSentence(genlInverse(?MID, ?HIGH)) , sbhlSentence(genlPreds(?LOW, ?MID)) .
impPred(imp#negationPredsLink) .
@{"urn:uuid:fb077766-347e-45d3-b834-ab6125747dfb"^^\iri} imp#negationPredsLink(?A, ?B) :- lookupSentence(negationPreds(?A, ?B)) .
@{"urn:uuid:5f8e4147-1c32-4704-8220-d9c5bd54b1ec"^^\iri} imp#negationPredsLink(?A, ?B) :- lookupSentence(negationPreds(?B, ?A)) .
impPred(imp#negationInverseLink) .
@{"urn:uuid:0e980f45-d14b-4ff7-98fd-91f8f9b9ad13"^^\iri} imp#negationInverseLink(?A, ?B) :- lookupSentence(negationInverse(?A, ?B)) .
@{"urn:uuid:d128cacf-2645-4274-9074-fe4f357b2390"^^\iri} imp#negationInverseLink(?A, ?B) :- lookupSentence(negationInverse(?B, ?A)) .
@{"urn:uuid:a3498bc6-f187-4444-8fcb-f728756e7bd9"^^\iri} imp#negationInverseLink(?A, ?A) :- sbhlSentence(cycIsa(?A, AsymmetricBinaryPredicate)) .
@{"urn:uuid:58d10c33-e6e0-47f4-813f-564c3701f655"^^\iri} sbhlSentence(negationPreds(?A, ?B)) :- \+ %silkb#isGround(?A)@builtin , %silkb#isGround(?B)@builtin , sbhlSentence(negationPreds(?B, ?A)) .
@{"urn:uuid:016ab3ee-7aee-4260-bf67-28f8213cd32a"^^\iri} sbhlSentence(negationPreds(?LOWA, ?LOWB)) :- %silkb#isGround(?LOWA)@builtin , sbhlSentence(genlPreds(?LOWA, ?A)) , imp#negationPredsLink(?A, ?B) , sbhlSentence(genlPreds(?LOWB, ?B)) .
@{"urn:uuid:13c5ad66-8940-4a3d-bfc0-6cfb6072641d"^^\iri} sbhlSentence(negationPreds(?LOWA, ?LOWB)) :- %silkb#isGround(?LOWA)@builtin , sbhlSentence(genlPreds(?LOWA, ?A)) , imp#negationInverseLink(?A, ?B) , sbhlSentence(genlInverse(?LOWB, ?B)) .
@{"urn:uuid:aac79801-6d08-4d55-a91e-9b1c3c2985fb"^^\iri} sbhlSentence(negationPreds(?LOWA, ?LOWB)) :- %silkb#isGround(?LOWA)@builtin , sbhlSentence(genlInverse(?LOWA, ?A)) , imp#negationPredsLink(?A, ?B) , sbhlSentence(genlInverse(?LOWB, ?B)) .
@{"urn:uuid:046f0b63-2169-43c0-844b-4ee68207c02c"^^\iri} sbhlSentence(negationPreds(?LOWA, ?LOWB)) :- %silkb#isGround(?LOWA)@builtin , sbhlSentence(genlInverse(?LOWA, ?A)) , imp#negationInverseLink(?A, ?B) , sbhlSentence(genlPreds(?LOWB, ?B)) .
@{"urn:uuid:610ed3cc-ede1-4b9d-bf48-37de912aadbe"^^\iri} sbhlSentence(negationInverse(?A, ?B)) :- \+ %silkb#isGround(?A)@builtin , %silkb#isGround(?B)@builtin , sbhlSentence(negationInverse(?B, ?A)) .
@{"urn:uuid:b24ffecc-2ea2-42a3-9907-af315be5a652"^^\iri} sbhlSentence(negationInverse(?LOWA, ?LOWB)) :- %silkb#isGround(?LOWA)@builtin , sbhlSentence(genlPreds(?LOWA, ?A)) , imp#negationInverseLink(?A, ?B) , sbhlSentence(genlPreds(?LOWB, ?B)) .
@{"urn:uuid:f0690d00-585d-450a-8ee4-868f081511c0"^^\iri} sbhlSentence(negationInverse(?LOWA, ?LOWB)) :- %silkb#isGround(?LOWA)@builtin , sbhlSentence(genlPreds(?LOWA, ?A)) , imp#negationPredsLink(?A, ?B) , sbhlSentence(genlInverse(?LOWB, ?B)) .
@{"urn:uuid:5f985aad-65d4-4e1c-91a5-62d9f535d3a5"^^\iri} sbhlSentence(negationInverse(?LOWA, ?LOWB)) :- %silkb#isGround(?LOWA)@builtin , sbhlSentence(genlInverse(?LOWA, ?A)) , imp#negationPredsLink(?A, ?B) , sbhlSentence(genlPreds(?LOWB, ?B)) .
@{"urn:uuid:6f2c155d-194a-4586-9005-ad603c4bdba7"^^\iri} sbhlSentence(negationInverse(?LOWA, ?LOWB)) :- %silkb#isGround(?LOWA)@builtin , sbhlSentence(genlInverse(?LOWA, ?A)) , imp#negationInverseLink(?A, ?B) , sbhlSentence(genlInverse(?LOWB, ?B)) .
impPred(imp#directGenlMt) .
@{"urn:uuid:0f893417-abd7-4721-ac91-26884de60583"^^\iri} imp#directGenlMt(?SPEC, ?GENL) :- lookupSentence(genlMt(?SPEC, ?GENL)) .
@{"urn:uuid:9b596908-21d0-4051-b24d-cf5fa856e01e"^^\iri} imp#directGenlMt(MtSpace(?MONAD, MtTimeDimFn(?TIME)), ?MONAD) :- %silkb#isGround(?MONAD)@builtin , %silkb#isGround(?TIME)@builtin , \naf imp#operatorInList(?MONAD, [MtSpace, MtTimeDimFn]) .
@{"urn:uuid:e0212fe9-2ff3-470a-860a-707d05248009"^^\iri} imp#directGenlMt(MtSpace(MtTimeDimFn(?TIME), ?MONAD), ?MONAD) :- %silkb#isGround(?MONAD)@builtin , %silkb#isGround(?TIME)@builtin , \naf imp#operatorInList(?MONAD, [MtSpace, MtTimeDimFn]) .
@{"urn:uuid:7f2d9b03-6226-4e69-92f5-26ee4468802e"^^\iri} imp#directGenlMt(MtSpace(MtTimeDimFn(?TIME), ?MONAD), MtSpace(?MONAD, MtTimeDimFn(?TIME))) :- %silkb#isGround(?MONAD)@builtin , %silkb#isGround(?TIME)@builtin , \naf imp#operatorInList(?MONAD, [MtSpace, MtTimeDimFn]) .
@{"urn:uuid:a610d706-4a70-4109-a291-5fc43e3b1df3"^^\iri} imp#directGenlMt(MtSpace(?MONAD, MtTimeDimFn(?TIME)), MtSpace(MtTimeDimFn(?TIME), ?MONAD)) :- %silkb#isGround(?MONAD)@builtin , %silkb#isGround(?TIME)@builtin , \naf imp#operatorInList(?MONAD, [MtSpace, MtTimeDimFn]) .
@{"urn:uuid:d5cd84e9-fab9-4561-aabb-0ca8cc1b7617"^^\iri} sbhlSentence(genlMt(?SPEC, ?GENL)) :- imp#directGenlMt(?SPEC, ?GENL) .
@{"urn:uuid:ed9740a2-ddaf-469c-b399-6aad11ca2a79"^^\iri} sbhlSentence(genlMt(?MT, ?MT)) :- sbhlSentence(cycIsa(?MT, Microtheory)) .
@{"urn:uuid:5e2db1ce-63d7-485e-b82a-f367d8a33bb4"^^\iri} sbhlSentence(genlMt(?LOW, ?HIGH)) :- %silkb#isGround(?LOW)@builtin , imp#directGenlMt(?LOW, ?MID) , sbhlSentence(genlMt(?MID, ?HIGH)) .
@{"urn:uuid:4ad11376-3ed4-4429-aa2b-ed33ef51b51a"^^\iri} sbhlSentence(genlMt(?LOW, ?HIGH)) :- %silkb#isGround(?HIGH)@builtin , \+ %silkb#isGround(?LOW)@builtin , imp#directGenlMt(?MID, ?HIGH) , sbhlSentence(genlMt(?LOW, ?MID)) .
impPred(imp#indirectIsa) .
@{"urn:uuid:d0681dbe-9730-44e0-8df3-46b887eb432c"^^\iri} imp#indirectIsa(?OBJ, ?FAR) :- %silkb#isGround(?OBJ)@builtin , imp#directIsa(?OBJ, ?NEAR) , sbhlSentence(genls(?NEAR, ?FAR)) , ?FAR != ?NEAR .
@{"urn:uuid:6981c945-a4e1-4ba6-a551-311d881d1c22"^^\iri} imp#indirectIsa(?OBJ, ?FAR) :- \+ %silkb#isGround(?OBJ)@builtin , %silkb#isGround(?FAR)@builtin , sbhlSentence(genls(?NEAR, ?FAR)) , imp#directIsa(?OBJ, ?NEAR) , ?FAR != ?NEAR .
@{"urn:uuid:5c5e7f6f-dfdf-49d7-875f-f748cf1ea8d1"^^\iri} sbhlSentence(nearestIsa(?OBJ, ?NEAR)) :- imp#directIsa(?OBJ, ?NEAR) , \naf imp#indirectIsa(?OBJ, ?NEAR) .
