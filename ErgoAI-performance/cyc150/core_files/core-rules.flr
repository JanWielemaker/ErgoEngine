@{"urn:uuid:e4baa992-c56f-44b1-af32-12ca04a49f3d"^^\iri} imp#defnAdmits(?X, Integer) :- imp#quotedDefnAdmits(?X, SubLInteger) .
@{"urn:uuid:3cfac49a-a352-423d-9306-baf4b6e673f9"^^\iri} imp#defnAdmits(?X, RealNumber) :- imp#quotedDefnAdmits(?X, SubLRealNumber) .
@{"urn:uuid:38a2824b-adba-4db3-987c-c31c6be38e56"^^\iri} imp#defnAdmits(?X, CharacterString) :- imp#quotedDefnAdmits(?X, SubLString) .
@{"urn:uuid:57f48e3d-e43e-4d45-99ba-e5972dfb7b54"^^\iri} imp#defnAdmits(?X, List) :- imp#quotedDefnAdmits(?X, ExtentionalList) .
impPred(quotedDefnSentence) .
@{"urn:uuid:5f892f24-2cee-4c34-b49b-e4127d7a0394"^^\iri} quotedDefnSentence(quotedIsa(?X, ?COL)) :- imp#quotedDefnAdmits(?X, ?DCOL) , sbhlSentence(genls(?DCOL, ?COL)) .
@{"urn:uuid:e7e54e70-1aaa-4eba-9b33-c6829df8d452"^^\iri} quotedDefnSentence(not(quotedIsa(?X, ?COL))) :- imp#quotedDefnAdmits(?X, ?DCOL) , sbhlSentence(disjointWith(?DCOL, ?COL)) .
impPred(defnSentence) .
@{"urn:uuid:26419d5a-9a11-4a9a-86cc-ee48b7ec3e6b"^^\iri} defnSentence(cycIsa(?X, ?COL)) :- imp#defnAdmits(?X, ?DCOL) , sbhlSentence(genls(?DCOL, ?COL)) .
@{"urn:uuid:9733cfe3-defa-415b-a9d5-09eb2562249a"^^\iri} defnSentence(not(cycIsa(?X, ?COL))) :- imp#defnAdmits(?X, ?DCOL) , sbhlSentence(disjointWith(?DCOL, ?COL)) .
@{"urn:uuid:41c8d584-e1cf-4472-bc64-e47152f2f99c"^^\iri} sbhlSentence(quotedIsa(?X, ?COL)) :- quotedDefnSentence(quotedIsa(?X, ?COL)) .
@{"urn:uuid:dc269b7b-81f2-4436-867c-7631a48d6cca"^^\iri} sbhlSentence(not(quotedIsa(?X, ?COL))) :- quotedDefnSentence(not(quotedIsa(?X, ?COL))) .
@{"urn:uuid:0f2e438d-0c50-476a-b18f-f6df8bce5e1f"^^\iri} imp#directIsa(?X, ?COL) :- imp#defnAdmits(?X, ?COL) .
@{"urn:uuid:9073ed23-c738-4c58-add7-6e2f47086882"^^\iri} sbhlSentence(cycIsa(?X, ?COL)) :- defnSentence(cycIsa(?X, ?COL)) .
@{"urn:uuid:b52b116a-bddb-4fc3-9411-aaa74e60729a"^^\iri} sbhlSentence(not(cycIsa(?X, ?COL))) :- defnSentence(not(cycIsa(?X, ?COL))) .
@{"urn:uuid:e8963eed-4281-4f17-aa1c-dc3134abcf9c"^^\iri} imp#directQuotedIsa(?X, ?COL) :- imp#quotedDefnAdmits(?X, ?COL) .
@{"urn:uuid:beae47ab-e8cd-42b7-b785-dcff703d28b2"^^\iri} sbhlSentence(quotedIsa(?X, ?COL)) :- quotedDefnSentence(quotedIsa(?X, ?COL)) .
@{"urn:uuid:1dcda76b-3b3a-4588-bc6d-3c2852dee38b"^^\iri} sbhlSentence(not(quotedIsa(?X, ?COL))) :- quotedDefnSentence(not(quotedIsa(?X, ?COL))) .
@{"urn:uuid:7e56041b-844b-4ecc-bbd1-71ae5861bf01"^^\iri} imp#defnAdmits(?X, NonNegativeInteger) :- imp#defnAdmits(?X, Integer) , ?X  >=  (0) .
@{"urn:uuid:1b671286-8adc-4122-818d-583635fd5f9c"^^\iri} imp#defnAdmits(?X, PositiveInteger) :- imp#defnAdmits(?X, Integer) , ?X  >  (0) .
impPred(imp#isAtomicSentence) .
@{"urn:uuid:3c30ab77-b6ef-4250-9ee7-c3a308e7d70e"^^\iri} imp#isAtomicSentence(?ASENT) :- operatorFormulas(?PRED, ?ASENT) , %silkb#isGround(?PRED)@builtin .
impPred(imp#wffRejectedArgument) .
@{"urn:uuid:09e9fc48-49c5-4473-94b9-6a5afe6f8497"^^\iri} imp#wffRejectedArgument(?TERM, ?N, ?RELN) :- %silkb#isGround(?TERM)@builtin , sbhlSentence(cycIsa(?RELN, Relation)) , lookupSentence(argIsa(?RELN, ?N, ?COL)) , sbhlSentence(not(cycIsa(?TERM, ?COL))) .
@{"urn:uuid:02b219d7-92ee-4c2c-b0eb-ecfeb879fd51"^^\iri} imp#wffRejectedArgument(?TERM, ?N, ?RELN) :- %silkb#isGround(?TERM)@builtin , sbhlSentence(cycIsa(?RELN, Relation)) , lookupSentence(argGenl(?RELN, ?N, ?COL)) , sbhlSentence(not(genls(?TERM, ?COL))) .
impPred(imp#wffAdmittedArgument) .
@{"urn:uuid:69f0e9fc-9fbd-42b1-a84b-b2d7be27bae8"^^\iri} imp#wffAdmittedArgument(?TERM, ?N, ?RELN) :- %silkb#isGround(?TERM)@builtin , sbhlSentence(cycIsa(?RELN, Relation)) , lookupSentence(arity(?RELN, ?MAX)) , integerBetween((1), ?N, ?MAX) , \naf imp#wffRejectedArgument(?TERM, ?N, ?RELN) .
impPred(imp#wffRejectedSentence) .
@{"urn:uuid:f923fd9c-52c9-499c-860d-d478dd6e9078"^^\iri} imp#wffRejectedSentence(?FORMULA) :- operatorFormulas(?RELN, ?FORMULA) , formulaArity(?FORMULA, ?ACTUAL) , lookupSentence(arity(?RELN, ?ARITY)) , ?ARITY != ?ACTUAL .
@{"urn:uuid:bec847aa-2ee0-4941-b56a-bf0414903605"^^\iri} imp#wffRejectedSentence(?FORMULA) :- %silkb#isGround(?FORMULA)@builtin , operatorFormulas(?RELN, ?FORMULA) , formulaArity(?FORMULA, ?ACTUAL) , integerBetween((1), ?N, ?ACTUAL) , argN(?TERM, ?N, ?FORMULA) , imp#wffRejectedArgument(?TERM, ?N, ?RELN) .
impPred(imp#wffAdmittedSentence) .
@{"urn:uuid:1c6ae1c8-62ef-4a07-8900-a9f09f24553a"^^\iri} imp#wffAdmittedSentence(?SENT) :- \naf rejectedSentence(?SENT) .
impPred(gpLookupSentence) .
@{"urn:uuid:8efc7e04-249b-4492-99e3-7a9ef0846f86"^^\iri} gpLookupSentence(?ASENT) :- imp#isAtomicSentence(?ASENT) , imp#destructureFormula(?ASENT, ?P, ?ARGS) , sbhlSentence(genlPreds(?SPEC, ?P)) , imp#destructureFormula(?ASENT2, ?SPEC, ?ARGS) , lookupSentence(?ASENT2) .
@{"urn:uuid:f36ca1d7-1d93-4676-8174-4f3e1af82762"^^\iri} gpLookupSentence(?P(?ARG1, ?ARG2)) :- sbhlSentence(cycIsa(?P, BinaryPredicate)) , sbhlSentence(genlInverse(?SPEC, ?P)) , lookupSentence(?P(?ARG2, ?ARG1)) .
@{"urn:uuid:bf1a8f37-6c43-4ea7-8b27-a8c670a8ddb5"^^\iri} gpLookupSentence(not(?ASENT)) :- imp#isAtomicSentence(?ASENT) , imp#destructureFormula(?ASENT, ?P, ?ARGS) , sbhlSentence(genlPreds(?P, ?GENL)) , imp#destructureFormula(?ASENT2, ?GENL, ?ARGS) , lookupSentence(not(?ASENT2)) .
@{"urn:uuid:79812a9d-939b-493e-bcc8-23846543e2e9"^^\iri} gpLookupSentence(not(?P(?ARG1, ?ARG2))) :- sbhlSentence(cycIsa(?P, BinaryPredicate)) , sbhlSentence(genlInverse(?P, ?GENL)) , lookupSentence(not(?GENL(?ARG2, ?ARG1))) .
impPred(imp#transitivityLink) .
@{"urn:uuid:241105d0-5676-46ac-bab8-7b3574edc5a4"^^\iri} imp#transitivityLink(?PTRANS(?A, ?B)) :- gpLookupSentence(?PTRANS(?A, ?B)) .
impPred(imp#transitivityWalk1to2) .
@{"urn:uuid:05be8765-66fc-4d71-92fe-a7ef86cdb5ed"^^\iri} imp#transitivityWalk1to2(?PTRANS(?A, ?B)) :- imp#transitivityLink(?PTRANS(?A, ?B)) .
@{"urn:uuid:f4827de7-1761-44e9-8425-e2bbbeceafa4"^^\iri} imp#transitivityWalk1to2(?PTRANS(?A, ?C)) :- imp#transitivityLink(?PTRANS(?A, ?B)) , imp#transitivityWalk1to2(?PTRANS(?C, ?C)) .
impPred(imp#transitivityWalk2to1) .
@{"urn:uuid:d07c9c36-95c9-4853-9f20-cd83e667e3d2"^^\iri} imp#transitivityWalk2to1(?PTRANS(?A, ?B)) :- imp#transitivityLink(?PTRANS(?A, ?B)) .
@{"urn:uuid:dac1e342-b612-435c-a1b5-dc5c8d1cb311"^^\iri} imp#transitivityWalk2to1(?PTRANS(?A, ?C)) :- imp#transitivityLink(?PTRANS(?B, ?C)) , imp#transitivityWalk2to1(?PTRANS(?A, ?B)) .
impPred(imp#transitivityFanoutArg) .
@{"urn:uuid:82e72a06-32d7-48c3-bec4-694f6109e11f"^^\iri} imp#transitivityFanoutArg(?PRED, ?N) :- lookupSentence(fanOutArg(?PRED, ?N)) .
@{"urn:uuid:778e4aa4-015d-40f8-89ed-28079a1650d2"^^\iri} imp#transitivityFanoutArg(?PRED, (1)) :- sbhlSentence(cycIsa(?PRED, BinaryPredicate)) , \naf imp#transitivityFanoutArg(?PRED, (2)) .
impPred(transitivitySentence) .
@{"urn:uuid:2de9f1bb-1761-4f89-b003-304542c675e6"^^\iri} transitivitySentence(?PTRANS(?A, ?C)) :- %silkb#isGround(?PTRANS)@builtin , \naf hlPred(?PTRANS) , %silkb#isGround(?A)@builtin , \+ %silkb#isGround(?C)@builtin , sbhlSentence(cycIsa(?PTRANS, TransitiveBinaryPredicate)) , imp#transitivityLink(?PTRANS(?A, ?B)) , imp#transitivityWalk1to2(?PTRANS(?B, ?C)) .
@{"urn:uuid:23e579e4-ee8c-4398-a643-9a22270d2e0d"^^\iri} transitivitySentence(?PTRANS(?A, ?C)) :- %silkb#isGround(?PTRANS)@builtin , \+ %silkb#isGround(?A)@builtin , %silkb#isGround(?C)@builtin , sbhlSentence(cycIsa(?PTRANS, TransitiveBinaryPredicate)) , imp#transitivityLink(?PTRANS(?B, ?C)) , imp#transitivityWalk2to1(?PTRANS(?A, ?B)) .
@{"urn:uuid:bb091e87-6314-4fef-84a6-5091badfe057"^^\iri} transitivitySentence(?PTRANS(?A, ?C)) :- %silkb#isGround(?PTRANS)@builtin , \naf hlPred(?PTRANS) , %silkb#isGround(?A)@builtin , %silkb#isGround(?C)@builtin , sbhlSentence(cycIsa(?PTRANS, TransitiveBinaryPredicate)) , imp#transitivityFanoutArg(?PTRANS, (1)) , imp#transitivityLink(?PTRANS(?A, ?B)) , imp#transitivityWalk1to2(?PTRANS(?B, ?C)) .
@{"urn:uuid:e824077c-46ec-4710-843d-1271b28d51a1"^^\iri} transitivitySentence(?PTRANS(?A, ?C)) :- %silkb#isGround(?PTRANS)@builtin , \naf hlPred(?PTRANS) , %silkb#isGround(?A)@builtin , %silkb#isGround(?C)@builtin , sbhlSentence(cycIsa(?PTRANS, TransitiveBinaryPredicate)) , imp#transitivityFanoutArg(?PTRANS, (2)) , imp#transitivityLink(?PTRANS(?B, ?C)) , imp#transitivityWalk2to1(?PTRANS(?A, ?B)) .
