@{"urn:uuid:24507ab2-cce2-46ad-8b51-ec3b79444b71"^^\iri} imp#quotedDefnAdmits(?X, SubLInteger) :- %silkb#isGround(?X)@builtin , %silkb#isInteger(?X)@builtin .
@{"urn:uuid:9d5569a8-824b-4408-9deb-b4d3acde93bd"^^\iri} imp#quotedDefnAdmits(?X, SubLRealNumber) :- %silkb#isGround(?X)@builtin , %silkb#isFloat(?X)@builtin .
@{"urn:uuid:d28b1237-2ede-469b-aeb1-f9e75bf94de0"^^\iri} imp#quotedDefnAdmits(?X, SubLString) :- %silkb#isGround(?X)@builtin , %silkb#isString(?X)@builtin .
@{"urn:uuid:b8ce30bf-3de9-4cf3-96aa-af7e3bcacc1b"^^\iri} imp#quotedDefnAdmits(?X, ExtentionalList) :- %silkb#isGround(?X)@builtin , %silkb#isList(?X)@builtin .
