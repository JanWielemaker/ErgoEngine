@{"urn:uuid:13940e1c-8870-4743-a0e3-03e28fec8d12"^^\iri} imp#decidableAsent(?ASENT) :- %silkb#isGround(?ASENT)@builtin , imp#isAtomicSentence(?ASENT) , operatorFormulas(?PRED, ?ASENT) , gpLookupSentence(completeExtentDecidable(?PRED)) .
@{"urn:uuid:c2ec6dd3-a302-443a-8236-2f187bfa841d"^^\iri} imp#decidableAsent(?ASENT) :- \+ %silkb#isGround(?ASENT)@builtin , imp#isAtomicSentence(?ASENT) , operatorFormulas(?PRED, ?ASENT) , gpLookupSentence(completeExtentEnumerable(?PRED)) .
@{"urn:uuid:4512910d-c87f-4964-9b4d-5ecff60c2a6a"^^\iri} imp#decidableAsent(cycIsa(?OBJ, ?COL)) :- \+ %silkb#isGround(?OBJ)@builtin , %silkb#isGround(?COL)@builtin , gpLookupSentence(completelyEnumerableCollection(?COL)) .
@{"urn:uuid:8207616a-16f9-43c0-8f3f-90963e25ebb2"^^\iri} imp#decidableAsent(cycIsa(?OBJ, ?COL)) :- %silkb#isGround(?OBJ)@builtin , %silkb#isGround(?COL)@builtin , gpLookupSentence(completelyDecidableCollection(?COL)) .
impPred(imp#tvaPredicate) .
@{"urn:uuid:45fe44df-f478-4538-8a18-09f27bd98c28"^^\iri} imp#tvaPredicate(?PRED) :- \naf hlPred(?PRED) , assertedSentence(transitiveViaArg(?PRED, ?_TRANS, ?_ARGNUM)) .
@{"urn:uuid:299c0f67-3fb4-4abe-86f6-4efcca4d6a03"^^\iri} imp#tvaPredicate(?PRED) :- \naf hlPred(?PRED) , assertedSentence(transitiveViaArgInverse(?PRED, ?_TRANS, ?_ARGNUM)) .
