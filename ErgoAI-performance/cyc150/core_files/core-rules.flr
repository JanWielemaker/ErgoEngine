@{"urn:uuid:a7898f0b-e4a2-4fda-b194-a8f12974a15d"^^\iri} imp#indirectGenls(?COL, ?FAR) :- %silkb#isGround(?COL)@builtin , imp#directGenls(?COL, ?NEAR) , sbhlSentence(genls(?NEAR, ?FAR)) , ?FAR != ?NEAR .
@{"urn:uuid:ff99f80f-73c6-4732-afa7-e5f45082e752"^^\iri} imp#indirectGenls(?COL, ?FAR) :- \+ %silkb#isGround(?COL)@builtin , %silkb#isGround(?FAR)@builtin , sbhlSentence(genls(?NEAR, ?FAR)) , imp#directGenls(?COL, ?NEAR) , ?FAR != ?NEAR .
@{"urn:uuid:09e19066-04ad-4798-b592-b37cc43b2914"^^\iri} sbhlSentence(nearestGenls(?COL, ?NEAR)) :- imp#directGenls(?COL, ?NEAR) , \naf imp#indirectGenls(?COL, ?NEAR) .
