checkingGround(?R) :- ground(?R).
%write_results(?R) :- writeln(?R)@\io.

%pretest :- true.

%test :- tell(temp)@\plg(), 
	Method[mustDefine(on)]@\sys,
	%pretest,
	Method[mustDefine(off)]@\sys,
	%pretest,
	told@\plg().

