:- iriprefix{silk = "http://vulcan.com/2008/silk#"}.
:- use_argumentation_theory{ogcle} .
?- [ogclpe>>ogcle] .
// :- setsemantics{tabling(incremental)}. (rejected by ErgoAI 3.01)
?-Method[mustDefine(on)]@\sys.

\overrides(?X,?Y) :- silk#overrides(?X,?Y) .
\overrides(?X,?Y,?Z,?W) :- silk#overrides(?X,?Y,?Z,?W) .
// ?- \optimize(class_expressions, main) . (not an ErgoAI 3.01 optimizer option)


?- [+'../aux_files/silk-predicates'],
   [+'../aux_files/silk-predicates_at_builtin'>>builtin],
	
	[+'core_files/core-pragmatics'],
	[+'core_files/core-rules'],
	[+'core_files/latest-tiny-kb'],
	[+'core_files/rmt-removal-lookup-pos-1'].

//?- ?query : silk#PersistentQuery[query-> ?text].
//?- \tracelow('/tmp/trace.out.biology-kb-v240-v2-with-definitions').
// KBQ:  : $CPTTest-CellWithCellPlateIsWhat (query 4)
// http://silk.bbn.com/index.php/Categorized_Candidate_Questions_for_Halo_Bio_Question_Answering : Example:__Biology_Chapter_12_Self-quiz.2C_Question_2

// Implicit Background Facts
istAsserted(UniversalVocabularyMt, cycIsa(genlMt, TransitiveBinaryPredicate)).
istAsserted(UniversalVocabularyMt, cycIsa(genlMt, ReflexiveBinaryPredicate)).
istAsserted(UniversalVocabularyMt, genlMt(MicrobiologicalChemistryMt, MicrobiologyMt)).
istAsserted(UniversalVocabularyMt, genlMt(MicrobiologyMt, MicrobiologyVocabularyMt)).
istAsserted(UniversalVocabularyMt, genlMt(MolecularBiologyMt, MolecularBiologyVocabularyMt)).
istAsserted(UniversalVocabularyMt, genlMt(CycAgencyTheoryMt, UniversalVocabularyMt)).
istAsserted(UniversalVocabularyMt, genlMt(BaseKB, CycAgencyTheoryMt)).
istAsserted(UniversalVocabularyMt, genlMt(MolecularBiologyVocabularyMt, MicrobiologicalChemistryMt)).
istAsserted(UniversalVocabularyMt, genlMt(MicrobiologyVocabularyMt, BiologyVocabularyMt)).
istAsserted(UniversalVocabularyMt, genlMt(ProprietaryMtFn(BiologyMt), BiologyMt)).
istAsserted(UniversalVocabularyMt, genlMt(BiologyVocabularyMt, ProprietaryMtFn(BiologyMt))).
istAsserted(UniversalVocabularyMt, genlMt(ReasoningToCausesFromObservationsMt, BaseKB)).
istAsserted(UniversalVocabularyMt, genlMt(CytologicalProcessesQueryMt, MolecularBiologyMt)).
istAsserted(UniversalVocabularyMt, genlMt(CytologicalProcessesQueryMt, ReasoningToCausesFromObservationsMt)).

// Implicit Background Rules
forwardSentence(cycIsa(?INST1, BotanicalCell)) :- removalSentence(internalParts(?INST1, ?INST2)), removalSentence(cycIsa(?INST2, CellPlate)).
forwardSentence(cycIsa(?INST1, CellTypeByCellLifeStageFn(Cytokinesis))) :- removalSentence(internalParts(?INST1, ?INST2)), removalSentence(cycIsa(?INST2, CellPlate)).

// Hypothesized Premises
istAsserted(UniversalVocabularyMt, cycIsa('Hypothesis-HypotheticalContext-259443', HypotheticalContext)).
istAsserted(UniversalVocabularyMt, genlMt('Hypothesis-HypotheticalContext-259443', CytologicalProcessesQueryMt)).
istAsserted(UniversalVocabularyMt, cycIsa('HYP-Cell-259444', Individual)).
istAsserted('Hypothesis-HypotheticalContext-259443', cycIsa('HYP-Cell-259444', Cell)).
istAsserted(UniversalVocabularyMt, cycIsa('HYP-CellPlate-259445', Individual)).
istAsserted('Hypothesis-HypotheticalContext-259443', cycIsa('HYP-CellPlate-259445', CellPlate)).
istAsserted('Hypothesis-HypotheticalContext-259443', cycIsa('HYP-CellPlate-259445', OrganicMaterial)).
istAsserted('Hypothesis-HypotheticalContext-259443', internalParts('HYP-Cell-259444', 'HYP-CellPlate-259445')).

// Query
queryMt('Hypothesis-HypotheticalContext-259443').
//REMOVED TITLE('KBQ  : $CPTTest-CellWithCellPlateIsWhat 4').
%pretest :- cycIsa('HYP-Cell-259444', BotanicalCell), cycIsa('HYP-Cell-259444', CellTypeByCellLifeStageFn(Cytokinesis)), %write_results('SUCCESS  : $CPTTest-CellWithCellPlateIsWhat 4').

// Debugging
proof(1467, 0) :- cycIsa('HYP-Cell-259444', BotanicalCell).
proof(1467, 1) :- cycIsa('HYP-Cell-259444', CellTypeByCellLifeStageFn(Cytokinesis)).
proof(1467, 2) :- cycIsa('HYP-Cell-259444', BotanicalCell), cycIsa('HYP-Cell-259444', CellTypeByCellLifeStageFn(Cytokinesis)).

proof(1467, 1000) :- genlMt(MicrobiologyMt, MicrobiologyVocabularyMt).
proof(1467, 1001) :- genlMt(MolecularBiologyMt, MolecularBiologyVocabularyMt).
proof(1467, 1002) :- genlMt(MolecularBiologyVocabularyMt, MicrobiologicalChemistryMt).
proof(1467, 1003) :- genlMt(MicrobiologyVocabularyMt, BiologyVocabularyMt).
proof(1467, 1004) :- genlMt(ProprietaryMtFn(BiologyMt), BiologyMt).
proof(1467, 1005) :- genlMt(BiologyVocabularyMt, ProprietaryMtFn(BiologyMt)).
proof(1467, 1006) :- genlMt(ReasoningToCausesFromObservationsMt, BaseKB).
proof(1467, 1007) :- cycIsa('HYP-Cell-259444', BotanicalCell).
proof(1467, 1008) :- cycIsa('HYP-Cell-259444', CellTypeByCellLifeStageFn(Cytokinesis)).

proof(1467, 2000) :- admittedArgument('Hypothesis-HypotheticalContext-259443', 1, genlMt).
proof(1467, 2001) :- admittedArgument('Hypothesis-HypotheticalContext-259443', 2, genlMt).
proof(1467, 2002) :- genlMt('Hypothesis-HypotheticalContext-259443', UniversalVocabularyMt).
proof(1467, 2003) :- genlMt('Hypothesis-HypotheticalContext-259443', 'Hypothesis-HypotheticalContext-259443').
proof(1467, 2004) :- genlMt('Hypothesis-HypotheticalContext-259443', BiologyMt).
proof(1467, 2005) :- cycIsa('HYP-Cell-259444', BotanicalCell).
proof(1467, 2006) :- cycIsa('HYP-Cell-259444', CellTypeByCellLifeStageFn(Cytokinesis)).
proof(1467, 2007) :- cycIsa('HYP-CellPlate-259445', CellPlate). 
checkingGround(?R) :- ground(?R).
%write_results(?R) :- writeln(?R)@\io.

%pretest :- true.

%test :- tell(temp)@\plg(), 
	Method[mustDefine(on)]@\sys,
	%pretest,
	Method[mustDefine(off)]@\sys,
	%pretest,
	told@\plg().

